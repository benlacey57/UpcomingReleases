# ==========================================
# Release Calendar Sync - Environment Config
# ==========================================

# Encryption key for secure token handling (Fernet format or derived password key)
ENCRYPTION_KEY=insecure-default-key-for-testing==

# Target Google Calendar ID (e.g., 'primary' or a specific calendar ID)
CALENDAR_ID=primary

# Preferred timezone for release scheduling (e.g., 'Europe/London' or 'UTC')
TIMEZONE=UTC

# Google Service Account JSON credentials string (single-line JSON or encrypted token)
GOOGLE_CREDENTIALS_JSON={}

# Feature Flags and Operational Controls
DRY_RUN=true
ENABLE_CALENDAR_SYNC=true
ENABLE_GIT_COMMIT=false
ENABLE_API_FETCH=true
